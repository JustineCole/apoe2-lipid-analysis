# Data files (private) - keep the folder, ignore its contents
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Reports and generated figures (not tracked - regenerate by running the script)
reports/*
!reports/.gitkeep
src/data/*.png

